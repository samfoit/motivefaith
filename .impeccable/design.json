  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The lamp as an action: one per view, for the step that matters.",
      "html": "<button class=\"ds-btn-primary\">Check in</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-sans);font-weight:500;font-size:0.875rem;line-height:1.25rem;padding:8px 16px;border-radius:10px;cursor:pointer;transition:transform 200ms cubic-bezier(.34,1.56,.64,1), background-color 150ms ease;background:var(--color-brand);color:var(--color-on-brand);border:1px solid transparent;}.ds-btn-primary:hover{background:var(--color-brand-hover);transform:translateY(-2px) scale(1.05);}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-bg-primary),0 0 0 4px var(--color-brand-ink);}.ds-btn-primary:disabled{opacity:.6;cursor:not-allowed;transform:none;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Lamp Ink outline for the second choice beside a primary.",
      "html": "<button class=\"ds-btn-secondary\">See how it works</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-sans);font-weight:500;font-size:0.875rem;line-height:1.25rem;padding:8px 16px;border-radius:10px;cursor:pointer;transition:transform 200ms cubic-bezier(.34,1.56,.64,1), background-color 150ms ease;background:transparent;color:var(--color-brand-ink);border:1px solid color-mix(in srgb, var(--color-brand-ink) 30%, transparent);}.ds-btn-secondary:hover{background:var(--color-brand-light);transform:translateY(-2px) scale(1.05);}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-bg-primary),0 0 0 4px color-mix(in srgb, var(--color-brand-ink) 50%, transparent);}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Text-only action in Lamp Ink for low-stakes choices.",
      "html": "<button class=\"ds-btn-ghost\">Not now</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-sans);font-weight:500;font-size:0.875rem;line-height:1.25rem;padding:8px 16px;border-radius:10px;cursor:pointer;transition:transform 200ms cubic-bezier(.34,1.56,.64,1), background-color 150ms ease;background:transparent;color:var(--color-brand-ink);border:1px solid transparent;}.ds-btn-ghost:hover{background:var(--color-surface-hover);transform:translateY(-2px) scale(1.05);}.ds-btn-ghost:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-brand-ink);}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "For what can't be taken back; opaque lighter hover keeps the dark label legible at night.",
      "html": "<button class=\"ds-btn-danger\">Delete content</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-sans);font-weight:500;font-size:0.875rem;line-height:1.25rem;padding:8px 16px;border-radius:10px;cursor:pointer;transition:transform 200ms cubic-bezier(.34,1.56,.64,1), background-color 150ms ease;background:var(--color-miss);color:var(--color-on-brand);border:1px solid transparent;}.ds-btn-danger:hover{background:var(--color-miss-hover);transform:translateY(-2px) scale(1.05);}.ds-btn-danger:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-bg-primary),0 0 0 4px var(--color-miss-ink);}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Card-colored field with a label above; 16px text so iOS never zooms.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Habit name</span><input class=\"ds-input\" placeholder=\"Morning prayer\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:var(--font-sans);}.ds-field-label{font-size:.875rem;font-weight:500;color:var(--color-text-primary);}.ds-input{width:100%;font:inherit;font-size:1rem;padding:8px 12px;border-radius:10px;border:1px solid var(--color-surface-hover);background:var(--color-bg-elevated);color:var(--color-text-primary);transition:border-color 150ms ease, box-shadow 150ms ease;}.ds-input::placeholder{color:var(--color-text-tertiary);}.ds-input:focus{outline:none;border-color:var(--color-brand-ink);box-shadow:0 0 0 2px var(--color-brand-ink);}"
    },
    {
      "name": "Habit Card",
      "kind": "card",
      "refersTo": "habit-card",
      "description": "Signature: a habit tinted by its color, with streak pill, meta row and the round check.",
      "html": "<div class=\"ds-habit\" style=\"--habit-color:#14B8A6\"><span class=\"ds-habit-handle\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></span><div class=\"ds-habit-body\"><div class=\"ds-habit-title\"><span>🙏</span><strong>Morning prayer</strong><span class=\"ds-streak\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/></svg>12</span></div><div class=\"ds-habit-meta\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>6:00 – 8:00 AM <span class=\"ds-pill\">Shared</span></div></div><span class=\"ds-check ds-check-done\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span></div>",
      "css": ".ds-habit{display:flex;align-items:center;gap:8px;padding:12px 16px 12px 8px;border-radius:14px;border:1px solid var(--habit-color, var(--color-surface-hover));background:color-mix(in oklab, var(--habit-color, var(--color-bg-elevated)) 5%, var(--color-bg-elevated));box-shadow:0 1px 2px rgba(0,0,0,.04);font-family:var(--font-sans);color:var(--color-text-primary);max-width:420px;}.ds-habit-handle{width:28px;display:flex;justify-content:center;color:var(--color-text-tertiary);}.ds-habit-body{flex:1;min-width:0;}.ds-habit-title{display:flex;align-items:center;gap:8px;font-size:1rem;}.ds-habit-title strong{font-weight:600;}.ds-streak{display:inline-flex;align-items:center;gap:2px;height:20px;padding:0 6px;border-radius:9999px;font-size:11px;font-weight:500;color:var(--color-streak);background:color-mix(in srgb, var(--color-streak) 14%, transparent);}.ds-habit-meta{display:flex;align-items:center;gap:6px;margin-top:2px;font-size:.75rem;color:var(--color-text-secondary);}.ds-pill{font-size:10px;font-weight:500;padding:2px 6px;border-radius:9999px;background:var(--color-brand-light);color:var(--color-brand-ink);}.ds-check{width:40px;height:40px;border-radius:9999px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 200ms var(--ease-bounce);}.ds-check-done{background:var(--color-brand);color:var(--color-on-brand);box-shadow:var(--lamp-glow-done);}"
    },
    {
      "name": "Check-in Drawer",
      "kind": "custom",
      "refersTo": "checkin-option",
      "description": "Signature: the row of fixed-hue check-in actions revealed when a habit card slides away.",
      "html": "<div class=\"ds-drawer\" style=\"--habit-color:#14B8A6\"><button class=\"ds-opt\" style=\"background:var(--color-checkin-quick)\" aria-label=\"Quick check-in\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></button><button class=\"ds-opt\" style=\"background:var(--color-checkin-photo)\" aria-label=\"Photo or video\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z\"/><circle cx=\"12\" cy=\"13\" r=\"3\"/></svg></button><button class=\"ds-opt\" style=\"background:var(--color-checkin-voice)\" aria-label=\"Voice\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/><line x1=\"12\" x2=\"12\" y1=\"19\" y2=\"22\"/></svg></button><button class=\"ds-opt\" style=\"background:var(--color-checkin-note)\" aria-label=\"Note\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg></button><button class=\"ds-opt\" style=\"background:var(--color-checkin-rain)\" aria-label=\"Rain check\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 14.9A7 7 0 1 1 15.7 8h1.8a4.5 4.5 0 0 1 2.5 8.2\"/><path d=\"M16 14v6\"/><path d=\"M8 14v6\"/><path d=\"M12 16v6\"/></svg></button></div>",
      "css": ".ds-drawer{display:flex;gap:10px;padding:12px 14px;border-radius:14px;background:color-mix(in oklab, var(--habit-color, var(--color-text-tertiary)) 10%, var(--color-surface-hover));box-shadow:inset 0 0 0 1px color-mix(in oklab, var(--habit-color, var(--color-text-tertiary)) 45%, var(--color-surface-hover));width:max-content;}.ds-opt{width:44px;height:44px;border-radius:9999px;border:none;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(0,0,0,.04);cursor:pointer;transition:transform 220ms cubic-bezier(.22,1,.36,1);}.ds-opt:active{transform:scale(.9);}.ds-opt:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-bg-primary),0 0 0 4px var(--color-brand-ink);}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "bottom-nav",
      "description": "Four destinations around the raised amber Capture button.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item ds-nav-active\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10l9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg><span>Home</span></a><a class=\"ds-nav-item\"><span class=\"ds-nav-ic\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/></svg><i class=\"ds-dot\"></i></span><span>Feed</span></a><button class=\"ds-capture\" aria-label=\"Capture\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z\"/><circle cx=\"12\" cy=\"13\" r=\"3\"/></svg></button><a class=\"ds-nav-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg><span>Friends</span></a><a class=\"ds-nav-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg><span>Profile</span></a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-around;height:64px;max-width:512px;background:var(--color-nav);border-top:1px solid var(--color-border);font-family:var(--font-sans);}.ds-nav-item{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:64px;color:var(--color-nav-text);font-size:10px;font-weight:500;text-decoration:none;cursor:pointer;transition:color 150ms ease;}.ds-nav-item:hover{color:var(--color-text-primary);}.ds-nav-active{color:var(--color-brand-ink);}.ds-nav-ic{position:relative;display:flex;}.ds-dot{position:absolute;top:-2px;right:-4px;width:8px;height:8px;border-radius:9999px;background:var(--color-brand);}.ds-capture{width:48px;height:48px;margin-top:-16px;border-radius:9999px;border:none;background:var(--color-brand);color:var(--color-on-brand);display:flex;align-items:center;justify-content:center;box-shadow:var(--lamp-glow-fab);cursor:pointer;transition:transform 200ms cubic-bezier(.34,1.56,.64,1);}.ds-capture:hover{transform:scale(1.1);}.ds-capture:active{transform:scale(.95);}.ds-capture:focus-visible{outline:2px solid var(--color-brand-ink);outline-offset:2px;}"
    },
    {
      "name": "Top Bar",
      "kind": "nav",
      "refersTo": "top-bar",
      "description": "Sky-colored bar with the serif greeting and round icon buttons.",
      "html": "<header class=\"ds-topbar\"><span class=\"ds-topbar-title\">Good afternoon, Alice</span><button class=\"ds-topbar-btn\" aria-label=\"Inbox\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg></button></header>",
      "css": ".ds-topbar{display:flex;align-items:center;justify-content:space-between;gap:8px;height:56px;padding:0 16px;background:var(--color-header);border-bottom:1px solid var(--color-border);max-width:420px;}.ds-topbar-title{font-family:var(--font-display);font-weight:500;font-size:clamp(1.125rem, 3vw + 0.5rem, 1.5rem);letter-spacing:-0.025em;line-height:1.25;color:var(--color-text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.ds-topbar-btn{width:40px;height:40px;border-radius:9999px;border:none;background:transparent;color:var(--color-text-secondary);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background-color 150ms ease,color 150ms ease;}.ds-topbar-btn:hover{background:var(--color-surface-hover);color:var(--color-text-primary);}.ds-topbar-btn:focus-visible{outline:2px solid var(--color-brand);outline-offset:2px;}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "pill-status",
      "description": "Small round pills: amber wash for status, each meaning hue over its own faint wash.",
      "html": "<div class=\"ds-pills\"><span class=\"ds-chip\">Shared</span><span class=\"ds-chip ds-chip-rain\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 14.9A7 7 0 1 1 15.7 8h1.8a4.5 4.5 0 0 1 2.5 8.2\"/><path d=\"M16 14v6\"/><path d=\"M8 14v6\"/><path d=\"M12 16v6\"/></svg>Rain check</span><span class=\"ds-chip ds-chip-streak\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/></svg>12</span></div>",
      "css": ".ds-pills{display:flex;gap:6px;align-items:center;font-family:var(--font-sans);}.ds-chip{display:inline-flex;align-items:center;gap:2px;font-size:10px;font-weight:500;padding:2px 6px;border-radius:9999px;background:var(--color-brand-light);color:var(--color-brand-ink);}.ds-chip-rain{color:var(--color-rain);background:color-mix(in srgb, var(--color-rain) 14%, transparent);}.ds-chip-streak{font-size:11px;color:var(--color-streak);background:color-mix(in srgb, var(--color-streak) 14%, transparent);}"
    }
  ],
  "narrative": {
    "northStar": "The Book of Hours",
    "overview": "MotiveFaith is drawn like a book of hours: every hour of the day has its own light, and the whole interface turns to it. The Lamplight palette moves through five hours (before dawn, sunrise, a clear midday, the blue hour at dusk, and a lamplit night), blending surfaces, text and a drawn sky so the app always looks like the time the user is in. Within the light family and within the dark family, color drifts continuously; the two meet only at sunrise and nightfall, where the screen crossfades once.\n\nThe mood is **calm, warm, unhurried**. Surfaces are quiet, cool and nearly flat; the one warm note is the lamp: Lampflame Amber on the primary action, the done check, and the capture button. By day that gold sits warm against a clear blue sky. By night it glows. Headings and greetings are set in a book serif with an optical-size axis; the working UI is a friendly, rounded sans. Density is phone-first and comfortable: one column, thumb-sized targets, 12–16px gaps between items.\n\nBrand art (link previews, hero art) stays minimal and flat: flat color fields, strong type, the lamp mark, small gold flames. Gradient \"night sky\" mood art, a day-to-night melting gradient, and dark inset boxes on light cards have all been tried and rejected.",
    "keyCharacteristics": [
      "The palette follows the hour; colors are tokens the theme rewrites, never fixed values.",
      "One gold lamp. Everything else stays cool and quiet so it reads.",
      "Light is the depth: hairlines and faint shadows by day, a gold glow by night.",
      "Serif for the voice (greetings, titles, verses); sans for the work.",
      "Soft and tactile: rounded shapes, a small springy response to touch.",
      "A drawn sky (stars, sun arc, hills, still water) lives behind every app screen, never behind text."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "Lampflame Amber is a fill, never text or an outline on a light ground: it fails contrast there. Gold text, icons and rings use Lamp Ink.",
        "section": "colors"
      },
      {
        "name": "The Hour Owns the Color Rule",
        "body": "Surface, text, border and sky colors come from the tokens `palette(hour)` writes (`--color-bg-*`, `--color-text-*`, `--color-header`, `--sky-*`), never from a hardcoded value. A new hour-dependent color is added to `src/lib/lamplight/palette.ts` and walked by its contrast test: text at 4.5:1, controls at 3:1, at every 15-minute step.",
        "section": "colors"
      },
      {
        "name": "The Red Means Missed Rule",
        "body": "Red is reserved for missed, danger and hearts. No action, category or decoration may borrow it. That is why the check-in hues leave the red-to-magenta arc empty. Red text is always Missed Red Ink; Missed Red is for fills, icons and borders.",
        "section": "colors"
      },
      {
        "name": "The Serif Speaks Rule",
        "body": "Newsreader carries voice: greetings, titles, verses, empty-state headlines. Controls, labels and lists stay in Figtree. Never set a button or form label in the serif.",
        "section": "typography"
      },
      {
        "name": "The Mono Counts Rule",
        "body": "JetBrains Mono is for numbers that are being counted (streaks, stats) and nothing else.",
        "section": "typography"
      },
      {
        "name": "The Solid Ground Rule",
        "body": "The sky is fixed behind the screen, and content scrolls over it only on solid surfaces. Text never sits directly on the sky drawing. Chat screens keep only the stars, because their composer covers the horizon band.",
        "section": "layout"
      },
      {
        "name": "The Thumb Rule",
        "body": "Every tap target reaches 44–48px, by stretching an invisible hit area where the visual element is smaller (40px bar buttons, the 28px card handle).",
        "section": "layout"
      },
      {
        "name": "The Lamp Is the Lift Rule",
        "body": "Only gold glows. Nothing else gets a colored shadow, and nothing gets a glow by day that it wouldn't get by night.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every surface, text, border and sky color from the Lamplight tokens, and check new work at a sunrise, midday, dusk, night and pre-dawn hour, not just light and dark.",
      "Do add any new hour-dependent color to `src/lib/lamplight/palette.ts` with a contrast test, not as an inline tint.",
      "Do keep Lampflame Amber to fills and use Lamp Ink for gold text, icons and focus rings.",
      "Do give each check-in action its own fixed hue everywhere it appears, from its `--color-checkin-*` token.",
      "Do make tap targets 44–48px, stretching a hidden hit area when the visual is smaller.",
      "Do honor `prefers-reduced-motion`: drop the bounces, shimmer and slides, keep state changes instant.",
      "Do keep brand art flat: flat color fields, the lamp mark, strong type, small gold flames; a night field is a flat full-bleed Starry Night with a clean edge."
    ],
    "donts": [
      "Don't use Lampflame Amber as text or an outline on a light ground.",
      "Don't use red for anything but missed, danger and hearts, don't set text in Missed Red (use Missed Red Ink), and don't style a rain check as an error.",
      "Don't put text directly on the sky drawing; it scrolls over on solid cards.",
      "Don't add colored shadows or glows to anything but gold, or a heavy drop shadow to a card.",
      "Don't set controls or form labels in Newsreader, or use JetBrains Mono for anything but counted numbers.",
      "Don't reach for raw Tailwind palette colors (`gray-*`, `emerald-*`, `indigo-*`, `rose-*`); they don't follow the hour. Card, Pill, Input and TextArea take only Lamplight tokens, and the Pill test fails if one comes back.",
      "Don't make brand visuals out of gradient night skies, a day-to-night melting gradient, or a dark inset box on a light card."
    ]
  }
}
